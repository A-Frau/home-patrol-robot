# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
#   cp .env.example .env

# Camera: pi (IMX219 on the camera port) or tapo (TP-Link Tapo C210)
CAMERA_SOURCE=pi

# Tapo C210: "camera account" (Kamera-Konto) from the Tapo app,
# NOT your TP-Link cloud login.
# Tapo app > camera > gear > Advanced Settings > Camera Account
TAPO_HOST=192.168.1.x
TAPO_USER=
TAPO_PASSWORD=
# stream2 = 640x360 (live view), stream1 = 2K (photos)
TAPO_STREAM=stream2
# Flip if a camera button moves the wrong way (true/1/yes).
# On the robot's C210 the left button turned the camera right: pan is inverted.
# TAPO_PAN_INVERTED=true
# TAPO_TILT_INVERTED=false
# Only if pan/tilt says "No such file: .../wsdl/devicemgmt.wsdl":
# folder that holds devicemgmt.wsdl (found automatically in most cases)
# TAPO_WSDL_DIR=/home/praew/.local/lib/python3.4/site-packages/wsdl
